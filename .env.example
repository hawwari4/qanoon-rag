# Copy this file to .env and adjust the values. Never commit .env.

# Generation backend: ollama | api | mock
LLM_BACKEND=ollama
# Any OpenAI-compatible endpoint. Inside Docker use http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b

# Retrieval: must match the model used to build the index
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=data/index/chroma
TOP_K=3
